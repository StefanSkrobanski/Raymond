{
    // Type-checks the library's JSDoc types (npm run typecheck). The
    // library stays plain JavaScript; tsconfig.types.json writes the .d.mts
    // declarations that npm users' editors read.
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": ["es2022", "dom"],
        "skipLibCheck": true
    },
    "include": ["src/**/*.mjs"]
}
